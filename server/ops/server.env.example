# /etc/pokewalker/server.env (root:pokewalker 640). APP_KEY: openssl rand -hex 16 — the same value goes into the app's Cloud.swift.
APP_KEY=
PORT=8787
DB_PATH=/var/lib/pokewalker/pokewalker.db
# The download page at / (server/README.md): the team password; empty = no page. RELEASE_DIR is where server/publish.sh puts the builds.
DOWNLOAD_PASSWORD=
RELEASE_DIR=/var/lib/pokewalker/release
# Save checks (docs/plans/10 §2): unset = log only; CHECK_MODE=reject refuses implausible saves (422); CHECK_REJECT_TESTS=1 refuses them for test IDs only (zz + 6 digits).
#CHECK_MODE=reject
CHECK_REJECT_TESTS=1
