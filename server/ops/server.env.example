# /etc/pokewalker/server.env (root:pokewalker 640). APP_KEY: openssl rand -hex 16 — the same value goes into the app's Cloud.swift.
APP_KEY=
PORT=8787
DB_PATH=/var/lib/pokewalker/pokewalker.db
# The download page at / (server/README.md): the team password; empty = the page open, no password (10-21). RELEASE_DIR is where server/publish.sh puts the builds.
DOWNLOAD_PASSWORD=
RELEASE_DIR=/var/lib/pokewalker/release
# The guide at /guide: its pictures, as server/guide.sh puts them (none: the text alone)
GUIDE_DIR=/var/lib/pokewalker/guide
# Save checks (docs/plans/10 §2): unset = log only; CHECK_MODE=reject refuses implausible saves (422); CHECK_REJECT_TESTS=1 refuses them for test IDs only (zz + 6 digits).
#CHECK_MODE=reject
CHECK_REJECT_TESTS=1
# 3.0 (docs/plans/11): apps older than this get 426 at login, save and the 2.x mints (set since 3.0 shipped).
MIN_APP=3.0
